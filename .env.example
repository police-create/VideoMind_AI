# ============================================================
# VideoMind AI - Environment Configuration
# ============================================================

# Google Gemini API Key (Get yours at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional YouTube Data API v3 Key (for comment insights and rich metadata fallback)
YOUTUBE_API_KEY=

# Model Configuration
# Primary LLM for reasoning, analysis, and synthesis
LLM_MODEL=gemini-2.5-flash
# Embedding model for vector semantic search
EMBEDDING_MODEL=text-embedding-004

# Retrieval Configuration
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5
HYBRID_ALPHA=0.65

# Application Settings
ENABLE_DEMO_MODE=true
ENABLE_WEB_VERIFICATION=false
MAX_SOURCES=5
LOG_LEVEL=INFO
DATABASE_PATH=data/videomind.db
